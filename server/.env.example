# MongoDB connection string (local docker-compose or MongoDB Atlas)
MONGO_URL=mongodb://127.0.0.1:27017/shop

# Secret for signing access tokens, at least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Sessions (see "Security" in the README). The access token is short-lived and kept in memory
# by the client; the refresh token lives in an httpOnly cookie and is rotated on every use.
ACCESS_TOKEN_TTL=15m
SESSION_TTL_DAYS=30

# Refresh-token cookie. Defaults fit a shop and API served from the same site
# (or the Vite proxy in development):
#   COOKIE_SAMESITE=lax, COOKIE_SECURE=auto (Secure in production only), no COOKIE_DOMAIN.
# Client and API on different sites (e.g. shop.vercel.app + api.onrender.com):
#   COOKIE_SAMESITE=none and COOKIE_SECURE=true, and CLIENT_URL must list the client origin.
# Subdomains of one site (shop.example.com + api.example.com) can keep lax;
#   COOKIE_DOMAIN is needed only to share the cookie between them.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=auto
# COOKIE_DOMAIN=

PORT=8000

# Comma-separated list of frontend origins allowed by CORS. Also the only origins allowed
# to use the refresh cookie (/api/auth/refresh and /logout check the Origin header).
CLIENT_URL=http://localhost:3000

# Max failed login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT=10

# Number of reverse proxies in front of the API (e.g. 1 on Render/Heroku)
TRUST_PROXY=0

# Optional: `npm run seed` creates an admin user "admin" with this password
# SEED_ADMIN_PASSWORD=

# Directory for images uploaded in the admin panel (served at /uploads)
UPLOAD_DIR=uploads

# Stripe test keys (optional). Without them orders are created as unpaid "pending".
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Outgoing email (optional), e.g. smtp://user:password@smtp.example.com:587
# Without it emails such as back-in-stock alerts are only logged.
# SMTP_URL=
# MAIL_FROM=Clothe Shop <no-reply@example.com>

# Public demo (optional): one-click "demo customer" / "demo admin" sign-in on the login page,
# and every night all shop data is reset to the demo state (visitor accounts are removed,
# the owner "admin" stays). Create the demo data once with `npm run seed:demo`.
# DEMO_MODE=true
# DEMO_RESET_HOUR=3
# DEMO_TIMEZONE=Europe/Warsaw
